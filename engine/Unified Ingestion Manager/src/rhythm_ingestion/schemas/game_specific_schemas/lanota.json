{
  "schema_id": "analysis_schema.lanota.v2",
  "game_id": "lanota",
  "kind": "analysis_schema",
  "scope": "Phase 3 UMI - analysis assumptions for Lanota",

  "notes": {
    "canonical_kinds": [
      "tap",
      "hold_path"
    ],

    "combo_definition": "circular-lane hit objects with angular positioning and time-based evaluation",

    "strict_combo_consistency": false,
    "max_db_note_delta": null
  },

  "sections": {
    "builder": "relative_time_window",
    "requires_bpm": false,
    "min_sections_for_analysis": 0
  },

  "severity_model": {
    "track": "A",
    "type": "geometry_and_density_based",
    "supports_section_coverage": false,
    "preserve_severity_labels": true
  },

  "selection": {
    "track": "B",
    "target_count_by_difficulty": {
      "default": 3
    },

    "allow_fallback_sort": true,
    "fallback_sort_key": [
      "score_desc",
      "severity_desc",
      "element_name_asc"
    ]
  },

  "tips": {
    "enabled": false,
    "rationale": "Lanota requires radial gesture and movement taxonomy before deterministic tips can be generated reliably."
  },

  "artifacts": {
    "training_mapping_default": "tips_training_mapping_lanota.json",
    "analysis_schema_default": null
  },

  "consistency_checks": {
    "table": [
      {
        "check_id": "L1",
        "name": "canonical kinds alignment",
        "expected": "note_events kinds must match schema.notes.canonical_kinds",
        "severity": "error"
      },
      {
        "check_id": "L2",
        "name": "time monotonicity",
        "expected": "time_beats must be non-decreasing",
        "severity": "error"
      },
      {
        "check_id": "L3",
        "name": "radial structure presence",
        "expected": "events should include angular or radial data in extra",
        "severity": "warning"
      },
      {
        "check_id": "L4",
        "name": "tips enablement gate",
        "expected": "Phase 4 must respect schema.tips.enabled",
        "severity": "warning"
      }
    ],

    "notes": "Focuses on radial geometry integrity and timeline consistency without referencing implementation details."
  }
}