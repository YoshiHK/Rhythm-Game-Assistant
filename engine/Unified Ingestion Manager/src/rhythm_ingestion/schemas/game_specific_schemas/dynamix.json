{
  "schema_id": "analysis_schema.dynamix.v2",
  "game_id": "dynamix",
  "kind": "analysis_schema",
  "scope": "Phase 3 UMI - analysis assumptions for Dynamix",

  "notes": {
    "canonical_kinds": [
      "tap",
      "hold_body_or_start",
      "hold_path"
    ],

    "combo_definition": "three-side hybrid hit objects with continuous position and width on a bar-based time axis",

    "strict_combo_consistency": false,
    "max_db_note_delta": null
  },

  "sections": {
    "builder": "relative_bar_window",
    "requires_bpm": false,
    "min_sections_for_analysis": 1
  },

  "severity_model": {
    "track": "A",
    "type": "density_and_spatial_distribution_based",
    "supports_section_coverage": true,
    "preserve_severity_labels": true
  },

  "selection": {
    "track": "B",
    "target_count_by_difficulty": {
      "default": 3
    },

    "allow_fallback_sort": true,
    "fallback_sort_key": [
      "score_desc",
      "severity_desc",
      "section_coverage_desc",
      "element_name_asc"
    ]
  },

  "tips": {
    "enabled": false,
    "rationale": "Dynamix charts involve multi-side interaction, continuous position, and width-based mechanics that require an explicit gesture and movement taxonomy before reliable tips can be generated."
  },

  "artifacts": {
    "training_mapping_default": "tips_training_mapping_dynamix.json",
    "analysis_schema_default": null
  },

  "consistency_checks": {
    "table": [
      {
        "check_id": "DY1",
        "name": "canonical kinds alignment",
        "expected": "note_events kinds must match schema.notes.canonical_kinds",
        "severity": "error"
      },
      {
        "check_id": "DY2",
        "name": "bar-time monotonicity",
        "expected": "time_beats must be non-decreasing",
        "severity": "error"
      },
      {
        "check_id": "DY3",
        "name": "multi-side structural presence",
        "expected": "events should include side/position/width information in extra",
        "severity": "warning"
      },
      {
        "check_id": "DY4",
        "name": "tips enablement gate",
        "expected": "Phase 4 must respect schema.tips.enabled",
        "severity": "warning"
      }
    ],

    "notes": "Focuses on bar-based timing consistency and multi-side spatial structure without referencing implementation details."
  }
}